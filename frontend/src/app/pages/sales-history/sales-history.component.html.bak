<div class="space-y-4 sm:space-y-6 p-3 sm:p-0" *ngIf="appState$ | async as appState">
  <!-- Header -->
  <div class="bg-gradient-to-r from-purple-600 to-indigo-700 p-4 sm:p-8 rounded-xl shadow-lg">
    <div class="flex items-center justify-between">
      <div class="flex-1 min-w-0">
        <h1 class="text-xl sm:text-3xl font-bold mb-1 sm:mb-2 text-white">Sales History</h1>
        <p class="text-purple-100 text-sm sm:text-lg truncate">Foreign Fits - Global Fashion</p>
        <p class="text-purple-200 text-xs sm:text-sm mt-1 hidden sm:block">Complete sales transaction history</p>
      </div>
      <div class="flex-shrink-0">
        <div class="p-2 sm:p-3 bg-purple-500 rounded-full">
          <svg class="h-6 w-6 sm:h-8 sm:w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Sales Table -->
  <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
    <!-- Filters toolbar -->
    <div class="p-3 sm:p-4 border-b border-gray-100 space-y-3">
      <!-- Search by Bill ID -->
      <div class="relative w-full">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-4 w-4 sm:h-5 sm:w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <input 
          type="text" 
          [(ngModel)]="searchQuery"
          placeholder="Search by Bill ID, Customer, Mobile..."
          class="pl-9 sm:pl-10 pr-4 py-2 w-full border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-purple-500 focus:border-transparent"
        />
      </div>
      
      <!-- Filter buttons row -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1">
        <button (click)="setFilter('all')" [class]="'px-3 py-1.5 rounded-lg text-xs sm:text-sm whitespace-nowrap ' + (filterMode==='all' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700 active:bg-gray-200')">All</button>
        <button (click)="setFilter('today')" [class]="'px-3 py-1.5 rounded-lg text-xs sm:text-sm whitespace-nowrap ' + (filterMode==='today' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700 active:bg-gray-200')">Today</button>
        <button (click)="setFilter('week')" [class]="'px-3 py-1.5 rounded-lg text-xs sm:text-sm whitespace-nowrap ' + (filterMode==='week' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700 active:bg-gray-200')">This Week</button>
        <button (click)="setFilter('month')" [class]="'px-3 py-1.5 rounded-lg text-xs sm:text-sm whitespace-nowrap ' + (filterMode==='month' ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700 active:bg-gray-200')">This Month</button>
      </div>
      
      <!-- Dropdowns row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
        <!-- Location Filter (ADMIN only) -->
        <select 
          *ngIf="isAdmin()" 
          [(ngModel)]="locationFilter"
          class="px-3 py-2 border border-gray-300 rounded-lg text-sm w-full"
        >
          <option value="all">All Stores</option>
          <option *ngFor="let location of getStoreLocations(appState)" [value]="location.id">
            {{ location.name }}
          </option>
        </select>
        
        <!-- Payment Type Filter -->
        <select 
          [(ngModel)]="paymentFilter"
          class="px-3 py-2 border border-gray-300 rounded-lg text-sm w-full"
        >
          <option value="all">All Payments</option>
          <option value="cash">💵 Cash</option>
          <option value="card">💳 Card</option>
          <option value="upi">📱 UPI</option>
        </select>

        <!-- Sales Person Filter (for incentive tracking) -->
        <select 
          [(ngModel)]="salesPersonFilter"
          class="px-3 py-2 border border-gray-300 rounded-lg text-sm w-full"
        >
          <option value="all">All Sales Persons</option>
          <option *ngFor="let salesPerson of getUniqueSalesPersons(appState)" [value]="salesPerson">
            👤 {{ salesPerson }}
          </option>
        </select>
      </div>
      
      <!-- Date range filter -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
        <input type="date" [(ngModel)]="fromDate" class="px-3 py-2 border border-gray-300 rounded-lg text-sm flex-1" placeholder="From date" />
        <span class="text-gray-400 text-center sm:px-2">to</span>
        <input type="date" [(ngModel)]="toDate" class="px-3 py-2 border border-gray-300 rounded-lg text-sm flex-1" placeholder="To date" />
        <button (click)="setFilter('range')" class="px-4 py-2 rounded-lg text-sm bg-blue-600 text-white active:bg-blue-700 touch-manipulation">Apply</button>
      </div>
    </div>
    
    <!-- Sales Person Filter Active Banner (for incentive tracking) -->
    <div *ngIf="salesPersonFilter !== 'all'" class="mx-3 sm:mx-4 mt-3 mb-2 bg-blue-50 border border-blue-200 rounded-lg p-3 flex items-start gap-2">
      <svg class="h-5 w-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
      <div class="flex-1">
        <p class="text-sm font-semibold text-blue-900">Showing sales for: {{ salesPersonFilter }}</p>
        <p class="text-xs text-blue-700 mt-0.5">Use the summary below to calculate incentives for this sales person</p>
      </div>
      <button (click)="salesPersonFilter = 'all'" class="text-blue-600 hover:text-blue-800 flex-shrink-0">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <!-- Mobile Card View -->
    <div class="block lg:hidden">
      <div *ngIf="getFilteredSales(appState).length === 0" class="p-6 text-center">
        <svg class="h-12 w-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-gray-500 text-sm">No sales found.</p>
      </div>
      
      <div class="divide-y divide-gray-200">
        <div *ngFor="let sale of getFilteredSales(appState)" 
             (click)="viewSaleDetails(sale)"
             class="p-4 active:bg-blue-50 transition-colors cursor-pointer touch-manipulation">
          <div class="flex justify-between items-start mb-3">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold text-purple-600 mb-1">#{{ sale.id.slice(0, 8) }}</p>
              <p class="text-xs text-gray-500">{{ sale.createdAt | date:'MMM d, y h:mm a' }}</p>
            </div>
            <div class="text-right flex-shrink-0">
              <p class="text-lg font-bold text-gray-900">₹{{ sale.total.toFixed(2) }}</p>
              <p class="text-xs text-gray-500">{{ sale.items.length || 0 }} item(s)</p>
            </div>
          </div>
          
          <div class="grid grid-cols-2 gap-2 text-xs">
            <div *ngIf="sale.customerName">
              <p class="text-gray-500">Customer</p>
              <p class="font-medium text-gray-900 truncate">{{ sale.customerName }}</p>
            </div>
            <div *ngIf="sale.customerPhone">
              <p class="text-gray-500">Mobile</p>
              <p class="font-medium text-gray-900">{{ sale.customerPhone }}</p>
            </div>
            <div>
              <p class="text-gray-500">Payment</p>
              <div *ngIf="!hasSplitPayment(sale)">
                <span [class]="getPaymentMethodClass(sale.paymentMethod) + ' text-xs'">
                  {{ sale.paymentMethod.toUpperCase() }}
                </span>
              </div>
              <div *ngIf="hasSplitPayment(sale)" class="space-y-1">
                <div *ngFor="let payment of sale.payments">
                  <span [class]="getPaymentMethodClass(payment.paymentMethod.toLowerCase()) + ' text-xs'">
                    {{ payment.paymentMethod }} ₹{{ payment.amount.toFixed(0) }}
                  </span>
                </div>
              </div>
            </div>
            <div *ngIf="isAdmin() && sale.location">
              <p class="text-gray-500">Location</p>
              <p class="font-medium text-gray-900 text-xs truncate">{{ sale.location.name }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Desktop Table View -->
    <div class="hidden lg:block overflow-auto max-h-[60vh]">
      <table class="w-full">
        <thead class="bg-gray-50 border-b border-gray-200 sticky top-0 z-10">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Date & Time
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Bill ID
            </th>
            <th *ngIf="isAdmin()" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Location
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Customer
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Mobile
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Sales Person
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Items
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Payment
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              Total
            </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <tr *ngIf="getFilteredSales(appState).length === 0">
            <td [attr.colspan]="isAdmin() ? 9 : 8" class="px-6 py-12 text-center">
              <svg class="h-12 w-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="height: 30px;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <p class="text-gray-500">No sales found.</p>
            </td>
          </tr>
          
          <tr *ngFor="let sale of getFilteredSales(appState)" 
              (click)="viewSaleDetails(sale)"
              class="hover:bg-blue-50 transition-colors cursor-pointer">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-900">
                {{ sale.createdAt | date:'short' }}
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-mono text-purple-600 font-medium">
                #{{ sale.id.slice(0, 8).toUpperCase() }}
              </div>
            </td>
            <td *ngIf="isAdmin()" class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-700">
                {{ sale.location.name || '—' }}
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-900">
                {{ sale.customerName || 'Walk-in Customer' }}
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-700">
                <span *ngIf="sale.customerPhone && sale.customerCountryCode">
                  {{ sale.customerCountryCode }} {{ sale.customerPhone }}
                </span>
                <span *ngIf="!sale.customerPhone" class="text-gray-400 text-xs">—</span>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-gray-700">
                <span *ngIf="sale.salesPersonName" class="inline-flex items-center gap-1">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                  {{ sale.salesPersonName }}
                </span>
                <span *ngIf="!sale.salesPersonName" class="text-gray-400 text-xs">—</span>
              </div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-900">
                {{ sale.items.length }} item{{ sale.items.length > 1 ? 's' : '' }}
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <!-- Single payment -->
              <span *ngIf="!hasSplitPayment(sale)" [class]="getPaymentMethodClass(sale.paymentMethod)">
                {{ sale.paymentMethod.toUpperCase() }}
              </span>
              <!-- Split payment -->
              <div *ngIf="hasSplitPayment(sale)" class="text-xs">
                <div *ngFor="let payment of sale.payments" class="mb-1">
                  <span [class]="getPaymentMethodClass(payment.paymentMethod.toLowerCase())">
                    {{ payment.paymentMethod }} ₹{{ payment.amount.toFixed(2) }}
                  </span>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-bold text-green-600">
                ₹{{ sale.total.toFixed(2) }}
              </div>
            </td>
          </tr>
        </tbody>
        <tfoot class="bg-gray-50 border-t border-gray-200">
          <tr>
            <td class="px-6 py-3" [attr.colspan]="isAdmin() ? 6 : 5"></td>
            <td class="px-6 py-3 whitespace-nowrap text-sm font-medium text-gray-700">
              {{ getFilteredItemsCount(appState) }} items
            </td>
            <td class="px-6 py-3"></td>
            <td class="px-6 py-3 whitespace-nowrap text-sm font-bold text-green-700">
              ₹{{ getFilteredRevenue(appState) | number:'1.2-2' }}
              <span class="text-gray-500 text-xs ml-2">({{ getFilteredCount(appState) }} sales)</span>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
    
    <!-- Mobile Footer Summary -->
    <div class="block lg:hidden border-t border-gray-200 bg-gray-50 p-4">
      <div class="flex justify-between items-center">
        <div>
          <p class="text-xs text-gray-500">Total Sales</p>
          <p class="text-lg font-bold text-gray-900">{{ getFilteredCount(appState) }}</p>
        </div>
        <div class="text-center">
          <p class="text-xs text-gray-500">Items</p>
          <p class="text-lg font-bold text-gray-900">{{ getFilteredItemsCount(appState) }}</p>
        </div>
        <div class="text-right">
          <p class="text-xs text-gray-500">Revenue</p>
          <p class="text-lg font-bold text-green-700">₹{{ getFilteredRevenue(appState) | number:'1.2-2' }}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sale Details Modal -->
<div *ngIf="showSaleDetails && selectedSale" 
     class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-3 sm:p-4"
     (click)="closeSaleDetails()">
  <div class="bg-white rounded-xl shadow-2xl max-w-3xl w-full max-h-[90vh] overflow-auto" 
       (click)="$event.stopPropagation()">
    
    <!-- Modal Header -->
    <div class="sticky top-0 bg-gradient-to-r from-purple-600 to-purple-700 text-white px-4 sm:px-6 py-3 sm:py-4 flex justify-between items-center rounded-t-xl z-10">
      <div class="min-w-0 flex-1">
        <h2 class="text-lg sm:text-2xl font-bold truncate">Sale Details</h2>
        <p class="text-purple-100 text-xs sm:text-sm truncate">Bill #{{ selectedSale.id.slice(0, 8).toUpperCase() }}</p>
      </div>
      <button (click)="closeSaleDetails()" 
              class="text-white hover:bg-purple-500 rounded-lg p-2 transition-colors flex-shrink-0 ml-2 touch-manipulation active:scale-95">
        <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="p-6 space-y-6">
      
      <!-- Sale Info Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <div class="bg-gray-50 p-3 rounded-lg">
          <p class="text-xs text-gray-500 mb-1">Date & Time</p>
          <p class="text-sm font-semibold text-gray-900">{{ selectedSale.createdAt | date:'short' }}</p>
        </div>
        <div class="bg-gray-50 p-3 rounded-lg">
          <p class="text-xs text-gray-500 mb-1">Customer</p>
          <p class="text-sm font-semibold text-gray-900">{{ selectedSale.customerName || 'Walk-in' }}</p>
        </div>
        <div class="bg-gray-50 p-3 rounded-lg">
          <p class="text-xs text-gray-500 mb-1">Mobile Number</p>
          <p class="text-sm font-semibold text-gray-900">
            <span *ngIf="selectedSale.customerPhone && selectedSale.customerCountryCode">
              {{ selectedSale.customerCountryCode }} {{ selectedSale.customerPhone }}
            </span>
            <span *ngIf="!selectedSale.customerPhone" class="text-gray-400">N/A</span>
          </p>
        </div>
        <div class="bg-gray-50 p-3 rounded-lg">
          <p class="text-xs text-gray-500 mb-1">Sales Person</p>
          <p class="text-sm font-semibold text-gray-900">
            <span *ngIf="selectedSale.salesPersonName" class="inline-flex items-center gap-1">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              {{ selectedSale.salesPersonName }}
            </span>
            <span *ngIf="!selectedSale.salesPersonName" class="text-gray-400">N/A</span>
          </p>
        </div>
        <div class="bg-gray-50 p-3 rounded-lg">
          <p class="text-xs text-gray-500 mb-1">Payment Method</p>
          <!-- Single payment -->
          <span *ngIf="!hasSplitPayment(selectedSale)" class="inline-block px-2 py-1 rounded-full text-xs font-medium"
                [class.bg-green-100]="selectedSale.paymentMethod === 'cash'"
                [class.text-green-700]="selectedSale.paymentMethod === 'cash'"
                [class.bg-blue-100]="selectedSale.paymentMethod === 'card'"
                [class.text-blue-700]="selectedSale.paymentMethod === 'card'"
                [class.bg-purple-100]="selectedSale.paymentMethod === 'upi'"
                [class.text-purple-700]="selectedSale.paymentMethod === 'upi'">
            {{ selectedSale.paymentMethod | uppercase }}
          </span>
          <!-- Split payment breakdown -->
          <div *ngIf="hasSplitPayment(selectedSale)" class="space-y-2">
            <div *ngFor="let payment of selectedSale.payments" class="flex justify-between items-center">
              <span class="inline-block px-2 py-1 rounded-full text-xs font-medium"
                    [class.bg-green-100]="payment.paymentMethod.toLowerCase() === 'cash'"
                    [class.text-green-700]="payment.paymentMethod.toLowerCase() === 'cash'"
                    [class.bg-blue-100]="payment.paymentMethod.toLowerCase() === 'card'"
                    [class.text-blue-700]="payment.paymentMethod.toLowerCase() === 'card'"
                    [class.bg-purple-100]="payment.paymentMethod.toLowerCase() === 'upi'"
                    [class.text-purple-700]="payment.paymentMethod.toLowerCase() === 'upi'">
                {{ payment.paymentMethod }}
              </span>
              <span class="text-sm font-semibold text-gray-900">₹{{ payment.amount.toFixed(2) }}</span>
            </div>
          </div>
        </div>
        <div class="bg-gray-50 p-3 rounded-lg">
          <p class="text-xs text-gray-500 mb-1">Sold By</p>
          <p class="text-sm font-semibold text-gray-900">{{ selectedSale.soldBy || 'N/A' }}</p>
        </div>
        <div class="bg-gray-50 p-3 rounded-lg">
          <p class="text-xs text-gray-500 mb-1">Location</p>
          <p class="text-sm font-semibold text-gray-900">{{ selectedSale.location.name || 'N/A' }}</p>
        </div>
      </div>

      <!-- Items Table -->
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-3">Items Purchased</h3>
        <div class="border border-gray-200 rounded-lg overflow-hidden">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Size</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Color</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Barcodes</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Qty</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Price</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <tr *ngFor="let item of selectedSale.items" class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <div class="text-sm font-medium text-gray-900">{{ item.product.name }}</div>
                  <div class="text-xs text-gray-500">{{ item.product.category }}</div>
                </td>
                <td class="px-4 py-3 text-sm text-gray-700">{{ item.product.size }}</td>
                <td class="px-4 py-3 text-sm text-gray-700">{{ item.product.color }}</td>
                <td class="px-4 py-3">
                  <div *ngIf="item.barcodes && item.barcodes.length > 0" class="flex flex-wrap gap-1">
                    <span *ngFor="let barcode of item.barcodes" 
                          class="inline-block px-2 py-1 text-xs font-mono bg-blue-50 text-blue-700 border border-blue-200 rounded">
                      {{ barcode }}
                    </span>
                  </div>
                  <span *ngIf="!item.barcodes || item.barcodes.length === 0" class="text-xs text-gray-400">No barcodes</span>
                </td>
                <td class="px-4 py-3 text-sm text-gray-900 text-right font-medium">{{ item.quantity }}</td>
                <td class="px-4 py-3 text-sm text-gray-700 text-right">₹{{ item.price.toFixed(2) }}</td>
                <td class="px-4 py-3 text-sm text-gray-900 text-right font-semibold">
                  ₹{{ (item.quantity * item.price).toFixed(2) }}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Totals Section -->
      <div class="border-t border-gray-200 pt-4">
        <div class="flex justify-end">
          <div class="w-full md:w-1/2 space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Subtotal:</span>
              <span class="font-medium text-gray-900">₹{{ selectedSale.subtotal.toFixed(2) }}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Tax:</span>
              <span class="font-medium text-gray-900">₹{{ selectedSale.tax.toFixed(2) }}</span>
            </div>
            <div class="border-t border-gray-300 pt-2 flex justify-between text-lg">
              <span class="font-bold text-gray-900">Total:</span>
              <span class="font-bold text-green-600">₹{{ selectedSale.total.toFixed(2) }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="bg-gray-50 px-6 py-4 flex justify-end gap-3 rounded-b-xl border-t border-gray-200">
      <button (click)="closeSaleDetails()" 
              class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100 transition-colors">
        Close
      </button>
      <button (click)="openExchangeModal(selectedSale!)" 
              *ngIf="selectedSale"
              class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors flex items-center gap-2">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
        </svg>
        Exchange
      </button>
      <button (click)="printSale()" 
              class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors flex items-center gap-2">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
        </svg>
        Print Receipt
      </button>
    </div>
  </div>
</div>

<!-- Exchange Modal -->
<app-exchange-modal
  *ngIf="showExchangeModal && exchangeSale"
  [sale]="exchangeSale"
  (closed)="closeExchangeModal()"
  (exchangeCreated)="onExchangeCreated()">
</app-exchange-modal>

<app-print-receipt
  *ngIf="showReceiptModal && receiptData"
  [receipt]="receiptData"
  [show]="showReceiptModal"
  (close)="showReceiptModal = false">
</app-print-receipt>
